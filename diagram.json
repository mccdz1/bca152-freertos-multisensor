{
  "version": 1,
  "author": "Michael Cadiz",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "board-ssd1306",
      "id": "oled",
      "top": -160,
      "left": 160,
      "attrs": { "i2cAddress": "0x3c" }
    },
    {
      "type": "wokwi-dht22",
      "id": "dht",
      "top": -150,
      "left": -120,
      "attrs": { "temperature": "24.5", "humidity": "60" }
    },
    {
      "type": "wokwi-photoresistor-sensor",
      "id": "ldr",
      "top": 200,
      "left": -160,
      "attrs": {}
    },
    {
      "type": "wokwi-pir-motion-sensor",
      "id": "pir",
      "top": -140,
      "left": 20,
      "attrs": {}
    },
    {
      "type": "wokwi-ky-040",
      "id": "encoder",
      "top": 200,
      "left": 140,
      "attrs": {}
    },
    {
      "type": "wokwi-buzzer",
      "id": "buzzer",
      "top": 70,
      "left": 230,
      "attrs": { "volume": "0.1" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "esp:3V3", "oled:VCC", "red", [ "v0" ] ],
    [ "esp:GND.1", "oled:GND", "black", [ "v0" ] ],
    [ "esp:21", "oled:SDA", "green", [ "v0" ] ],
    [ "esp:22", "oled:SCL", "blue", [ "v0" ] ],

    [ "esp:3V3", "dht:VCC", "red", [ "v0" ] ],
    [ "esp:GND.1", "dht:GND", "black", [ "v0" ] ],
    [ "esp:4", "dht:SDA", "orange", [ "v0" ] ],

    [ "esp:3V3", "ldr:VCC", "red", [ "v0" ] ],
    [ "esp:GND.1", "ldr:GND", "black", [ "v0" ] ],
    [ "esp:34", "ldr:AO", "purple", [ "v0" ] ],

    [ "esp:3V3", "pir:VCC", "red", [ "v0" ] ],
    [ "esp:GND.2", "pir:GND", "black", [ "v0" ] ],
    [ "esp:13", "pir:OUT", "yellow", [ "v0" ] ],

    [ "esp:3V3", "encoder:VCC", "red", [ "v0" ] ],
    [ "esp:GND.2", "encoder:GND", "black", [ "v0" ] ],
    [ "esp:18", "encoder:CLK", "cyan", [ "v0" ] ],
    [ "esp:19", "encoder:DT", "violet", [ "v0" ] ],
    [ "esp:5", "encoder:SW", "white", [ "v0" ] ],

    [ "esp:15", "buzzer:2", "red", [ "v0" ] ],
    [ "esp:GND.2", "buzzer:1", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}
